NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
API_BASE=http://127.0.0.1:8080
ADMIN_TOKEN=
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

NEXTAUTH_URL=https://ruangsinyal.com
AUTH_SECRET=
NEXTAUTH_SECRET=

# Google OAuth.
# Buat credential di Google Cloud Console, lalu isi Client ID dan Client Secret.
# Redirect URI development:
#   http://localhost:3000/api/auth/callback/google
# Redirect URI production:
#   https://ruangsinyal.com/api/auth/callback/google
GOOGLE_LOGIN_ENABLED=true
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alias optional jika deployment memakai nama env Auth.js:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Pulsa24Jam provider integration.
# Credential asli disimpan di server/deployment environment, bukan di browser.
PULSA24JAM_BASE_URL=https://api-url-resmi-pulsa24jam
PULSA24JAM_API_KEY=
PULSA24JAM_PIN=
PULSA24JAM_PASSWORD=
PULSA24JAM_SECRET=
PULSA24JAM_CALLBACK_TOKEN=
